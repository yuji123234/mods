using BepInEx;
using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;
using System.Collections.Generic;

[BepInPlugin(
        "com.stupidnitromonkey.modmenu",
            "STUPID NITRO MONKEY",
                "1.0.0"
)]
public class StupidNitroMonkeyMenu : BaseUnityPlugin
{
        private GameObject menu;
            private Canvas canvas;

                private bool menuOpen;
                    private bool flyEnabled;
                        private bool speedEnabled;
                            private bool longArmsEnabled;
                                private bool teleportEnabled;

                                    private float speed = 1.5f;
                                        private float armLength = 1.25f;

                                            private readonly List<GameObject> buttons =
                                                    new List<GameObject>();

                                                        private Color background =
                                                                new Color(0.035f, 0.04f, 0.06f, 0.97f);

                                                                    private Color buttonOff =
                                                                            new Color(0.09f, 0.11f, 0.16f);

                                                                                private Color buttonOn =
                                                                                        new Color(0.18f, 0.75f, 0.55f);

                                                                                            void Start()
                                                                                                {
                                                                                                            CreateMenu();

                                                                                                                    if (menu != null)
                                                                                                                                menu.SetActive(false);
                                                                                                }

                                                                                                    void Update()
                                                                                                        {
                                                                                                                    // PC testing:
                                                                                                                            // X = open / close
                                                                                                                                    if (Input.GetKeyDown(KeyCode.X))
                                                                                                                                                ToggleMenu();

                                                                                                                                                        // A = fly toggle
                                                                                                                                                                if (Input.GetKeyDown(KeyCode.A))
                                                                                                                                                                        {
                                                                                                                                                                                        flyEnabled = !flyEnabled;
                                                                                                                                                                                                    UpdateButtons();
                                                                                                                                                                        }

                                                                                                                                                                                if (flyEnabled)
                                                                                                                                                                                            HandleFly();
                                                                                                        }

                                                                                                            void CreateMenu()
                                                                                                                {
                                                                                                                            GameObject canvasObject =
                                                                                                                                        new GameObject("StupidNitroMonkeyCanvas");

                                                                                                                                                canvas = canvasObject.AddComponent<Canvas>();
                                                                                                                                                        canvas.renderMode = RenderMode.WorldSpace;

                                                                                                                                                                CanvasScaler scaler =
                                                                                                                                                                            canvasObject.AddComponent<CanvasScaler>();

                                                                                                                                                                                    scaler.dynamicPixelsPerUnit = 10;

                                                                                                                                                                                            canvasObject.AddComponent<GraphicRaycaster>();

                                                                                                                                                                                                    menu = new GameObject("StupidNitroMonkeyMenu");

                                                                                                                                                                                                            menu.transform.SetParent(
                                                                                                                                                                                                                            canvas.transform,
                                                                                                                                                                                                                                        false
                                                                                                                                                                                                            );

                                                                                                                                                                                                                    RectTransform menuRect =
                                                                                                                                                                                                                                menu.AddComponent<RectTransform>();

                                                                                                                                                                                                                                        menuRect.sizeDelta =
                                                                                                                                                                                                                                                    new Vector2(500, 700);

                                                                                                                                                                                                                                                            Image backgroundImage =
                                                                                                                                                                                                                                                                        menu.AddComponent<Image>();

                                                                                                                                                                                                                                                                                backgroundImage.color =
                                                                                                                                                                                                                                                                                            background;

                                                                                                                                                                                                                                                                                                    // Main title
                                                                                                                                                                                                                                                                                                            GameObject title =
                                                                                                                                                                                                                                                                                                                        CreateText(
                                                                                                                                                                                                                                                                                                                                            "STUPID NITRO MONKEY",
                                                                                                                                                                                                                                                                                                                                                            new Vector2(0, 300),
                                                                                                                                                                                                                                                                                                                                                                            30
                                                                                                                                                                                                                                                                                                                        );

                                                                                                                                                                                                                                                                                                                                title.transform.SetParent(
                                                                                                                                                                                                                                                                                                                                                menu.transform,
                                                                                                                                                                                                                                                                                                                                                            false
                                                                                                                                                                                                                                                                                                                                );

                                                                                                                                                                                                                                                                                                                                        // Subtitle
                                                                                                                                                                                                                                                                                                                                                GameObject subtitle =
                                                                                                                                                                                                                                                                                                                                                            CreateText(
                                                                                                                                                                                                                                                                                                                                                                                "PRIVATE MOD MENU",
                                                                                                                                                                                                                                                                                                                                                                                                new Vector2(0, 265),
                                                                                                                                                                                                                                                                                                                                                                                                                15
                                                                                                                                                                                                                                                                                                                                                            );

                                                                                                                                                                                                                                                                                                                                                                    subtitle.transform.SetParent(
                                                                                                                                                                                                                                                                                                                                                                                    menu.transform,
                                                                                                                                                                                                                                                                                                                                                                                                false
                                                                                                                                                                                                                                                                                                                                                                    );

                                                                                                                                                                                                                                                                                                                                                                            CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                            "FLY",
                                                                                                                                                                                                                                                                                                                                                                                                        200,
                                                                                                                                                                                                                                                                                                                                                                                                                    ToggleFly
                                                                                                                                                                                                                                                                                                                                                                            );

                                                                                                                                                                                                                                                                                                                                                                                    CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                    "SPEED BOOST",
                                                                                                                                                                                                                                                                                                                                                                                                                130,
                                                                                                                                                                                                                                                                                                                                                                                                                            ToggleSpeed
                                                                                                                                                                                                                                                                                                                                                                                    );

                                                                                                                                                                                                                                                                                                                                                                                            CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                            "LONG ARMS",
                                                                                                                                                                                                                                                                                                                                                                                                                        60,
                                                                                                                                                                                                                                                                                                                                                                                                                                    ToggleLongArms
                                                                                                                                                                                                                                                                                                                                                                                            );

                                                                                                                                                                                                                                                                                                                                                                                                    CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                                    "TELEPORT",
                                                                                                                                                                                                                                                                                                                                                                                                                                -10,
                                                                                                                                                                                                                                                                                                                                                                                                                                            ToggleTeleport
                                                                                                                                                                                                                                                                                                                                                                                                    );

                                                                                                                                                                                                                                                                                                                                                                                                            CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                                            "SPEED +",
                                                                                                                                                                                                                                                                                                                                                                                                                                        -90,
                                                                                                                                                                                                                                                                                                                                                                                                                                                    IncreaseSpeed
                                                                                                                                                                                                                                                                                                                                                                                                            );

                                                                                                                                                                                                                                                                                                                                                                                                                    CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                                                    "SPEED -",
                                                                                                                                                                                                                                                                                                                                                                                                                                                -155,
                                                                                                                                                                                                                                                                                                                                                                                                                                                            DecreaseSpeed
                                                                                                                                                                                                                                                                                                                                                                                                                    );

                                                                                                                                                                                                                                                                                                                                                                                                                            CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                                                            "ARM LENGTH +",
                                                                                                                                                                                                                                                                                                                                                                                                                                                        -220,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    IncreaseArms
                                                                                                                                                                                                                                                                                                                                                                                                                            );

                                                                                                                                                                                                                                                                                                                                                                                                                                    CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                                                                    "ARM LENGTH -",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                -285,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            DecreaseArms
                                                                                                                                                                                                                                                                                                                                                                                                                                    );

                                                                                                                                                                                                                                                                                                                                                                                                                                            // Safe disconnect button
                                                                                                                                                                                                                                                                                                                                                                                                                                                    CreateButton(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "DISCONNECT",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                -370,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            SafeDisconnect
                                                                                                                                                                                                                                                                                                                                                                                                                                                    );

                                                                                                                                                                                                                                                                                                                                                                                                                                                            UpdateButtons();
                                                                                                                                                                                                                                                                                                                                                                                                                                                            fly=true

                                                                                                                                                                                                                                                                                                                                                                                                                                                            speed=( 5' 5' 5')()

                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                }

                                                                                                                    GameObject CreateText(
                                                                                                                                string text,
                                                                                                                                        Vector2 position,
                                                                                                                                                int size
                                                                                                                    )
                                                                                                                        {
                                                                                                                                    GameObject obj =
                                                                                                                                                new GameObject(text);

                                                                                                                                                        Text label =
                                                                                                                                                                    obj.AddComponent<Text>();

                                                                                                                                                                            label.text = text;

                                                                                                                                                                                    label.font =
                                                                                                                                                                                                Resources.GetBuiltinResource<Font>(
                                                                                                                                                                                                                    "Arial.ttf"
                                                                                                                                                                                                );

                                                                                                                                                                                                        label.fontSize = size;
                                                                                                                                                                                                                label.alignment =
                                                                                                                                                                                                                            TextAnchor.MiddleCenter;

                                                                                                                                                                                                                                    label.color = Color.white;

                                                                                                                                                                                                                                            RectTransform rect =
                                                                                                                                                                                                                                                        obj.GetComponent<RectTransform>();

                                                                                                                                                                                                                                                                rect.sizeDelta =
                                                                                                                                                                                                                                                                            new Vector2(450, 60);

                                                                                                                                                                                                                                                                                    rect.anchoredPosition =
                                                                                                                                                                                                                                                                                                position;

                                                                                                                                                                                                                                                                                                        return obj;
                                                                                                                        }

                                                                                                                            void CreateButton(
                                                                                                                                        string text,
                                                                                                                                                float y,
                                                                                                                                                        UnityEngine.Events.UnityAction action
                                                                                                                            )
                                                                                                                                {
                                                                                                                                            GameObject obj =
                                                                                                                                                        new GameObject(text);

                                                                                                                                                                obj.transform.SetParent(
                                                                                                                                                                                menu.transform,
                                                                                                                                                                                            false
                                                                                                                                                                );

                                                                                                                                                                        RectTransform rect =
                                                                                                                                                                                    obj.AddComponent<RectTransform>();

                                                                                                                                                                                            rect.sizeDelta =
                                                                                                                                                                                                        new Vector2(420, 55);

                                                                                                                                                                                                                rect.anchoredPosition =
                                                                                                                                                                                                                            new Vector2(0, y);

                                                                                                                                                                                                                                    Image image =
                                                                                                                                                                                                                                                obj.AddComponent<Image>();

                                                                                                                                                                                                                                                        image.color =
                                                                                                                                                                                                                                                                    buttonOff;

                                                                                                                                                                                                                                                                            Button button =
                                                                                                                                                                                                                                                                                        obj.AddComponent<Button>();

                                                                                                                                                                                                                                                                                                button.onClick.AddListener(action);

                                                                                                                                                                                                                                                                                                        Text label =
                                                                                                                                                                                                                                                                                                                    CreateText(
                                                                                                                                                                                                                                                                                                                                        text,
                                                                                                                                                                                                                                                                                                                                                        Vector2.zero,
                                                                                                                                                                                                                                                                                                                                                                        18
                                                                                                                                                                                                                                                                                                                    );

                                                                                                                                                                                                                                                                                                                            label.transform.SetParent(
                                                                                                                                                                                                                                                                                                                                            obj.transform,
                                                                                                                                                                                                                                                                                                                                                        false
                                                                                                                                                                                                                                                                                                                            );

                                                                                                                                                                                                                                                                                                                                    RectTransform labelRect =
                                                                                                                                                                                                                                                                                                                                                label.GetComponent<RectTransform>();

                                                                                                                                                                                                                                                                                                                                                        labelRect.anchorMin =
                                                                                                                                                                                                                                                                                                                                                                    Vector2.zero;

                                                                                                                                                                                                                                                                                                                                                                            labelRect.anchorMax =
                                                                                                                                                                                                                                                                                                                                                                                        Vector2.one;

                                                                                                                                                                                                                                                                                                                                                                                                labelRect.offsetMin =
                                                                                                                                                                                                                                                                                                                                                                                                            Vector2.zero;

                                                                                                                                                                                                                                                                                                                                                                                                                    labelRect.offsetMax =
                                                                                                                                                                                                                                                                                                                                                                                                                                Vector2.zero;

                                                                                                                                                                                                                                                                                                                                                                                                                                        buttons.Add(obj);
                                                                                                                                }

                                                                                                                                    void ToggleMenu()
                                                                                                                                        {
                                                                                                                                                    menuOpen = !menuOpen;

                                                                                                                                                            if (menuOpen)
                                                                                                                                                                    {
                                                                                                                                                                                    menu.SetActive(true);

                                                                                                                                                                                                menu.transform.localScale =
                                                                                                                                                                                                                Vector3.zero;

                                                                                                                                                                                                                            StartCoroutine(
                                                                                                                                                                                                                                                OpenAnimation()
                                                                                                                                                                                                                            );
                                                                                                                                                                    }
                                                                                                                                                                            else
                                                                                                                                                                                    {
                                                                                                                                                                                                    StartCoroutine(
                                                                                                                                                                                                                        CloseAnimation()
                                                                                                                                                                                                    );
                                                                                                                                                                                    }
                                                                                                                                        }

                                                                                                                                            System.Collections.IEnumerator OpenAnimation()
                                                                                                                                                {
                                                                                                                                                            float time = 0f;
                                                                                                                                                                    float duration = 0.2f;

                                                                                                                                                                            while (time < duration)
                                                                                                                                                                                    {
                                                                                                                                                                                                    time += Time.deltaTime;

                                                                                                                                                                                                                float t =
                                                                                                                                                                                                                                time / duration;

                                                                                                                                                                                                                                            t =
                                                                                                                                                                                                                                                            1f -
                                                                                                                                                                                                                                                                            Mathf.Pow(1f - t, 3f);

                                                                                                                                                                                                                                                                                        menu.transform.localScale =
                                                                                                                                                                                                                                                                                                        Vector3.one * t;

                                                                                                                                                                                                                                                                                                                    yield return null;
                                                                                                                                                                                    }

                                                                                                                                                                                            menu.transform.localScale =
                                                                                                                                                                                                        Vector3.one;
                                                                                                                                                }

                                                                                                                                                    System.Collections.IEnumerator CloseAnimation()
                                                                                                                                                        {
                                                                                                                                                                    float time = 0f;
                                                                                                                                                                            float duration = 0.15f;

                                                                                                                                                                                    while (time < duration)
                                                                                                                                                                                            {
                                                                                                                                                                                                            time += Time.deltaTime;

                                                                                                                                                                                                                        float t =
                                                                                                                                                                                                                                        time / duration;

                                                                                                                                                                                                                                                    menu.transform.localScale =
                                                                                                                                                                                                                                                                    Vector3.one *
                                                                                                                                                                                                                                                                                    (1f - t);

                                                                                                                                                                                                                                                                                                yield return null;
                                                                                                                                                                                            }

                                                                                                                                                                                                    menu.SetActive(false);
                                                                                                                                                        }

                                                                                                                                                            void ToggleFly()
                                                                                                                                                                {
                                                                                                                                                                            flyEnabled =
                                                                                                                                                                                        !flyEnabled;

                                                                                                                                                                                                UpdateButtons();
                                                                                                                                                                }

                                                                                                                                                                    void ToggleSpeed()
                                                                                                                                                                        {
                                                                                                                                                                                    speedEnabled =
                                                                                                                                                                                                !speedEnabled;

                                                                                                                                                                                                        UpdateButtons();
                                                                                                                                                                        }

                                                                                                                                                                            void ToggleLongArms()
                                                                                                                                                                                {
                                                                                                                                                                                            longArmsEnabled =
                                                                                                                                                                                                        !longArmsEnabled;

                                                                                                                                                                                                                UpdateButtons();
                                                                                                                                                                                }

                                                                                                                                                                                    void ToggleTeleport()
                                                                                                                                                                                        {
                                                                                                                                                                                                    teleportEnabled =
                                                                                                                                                                                                                !teleportEnabled;

                                                                                                                                                                                                                        UpdateButtons();
                                                                                                                                                                                        }

                                                                                                                                                                                            void IncreaseSpeed()
                                                                                                                                                                                                {
                                                                                                                                                                                                            speed += 0.25f;

                                                                                                                                                                                                                    if (speed > 5f)
                                                                                                                                                                                                                                speed = 5f;
                                                                                                                                                                                                }

                                                                                                                                                                                                    void DecreaseSpeed()
                                                                                                                                                                                                        {
                                                                                                                                                                                                                    speed -= 0.25f;

                                                                                                                                                                                                                            if (speed < 0.5f)
                                                                                                                                                                                                                                        speed = 0.5f;
                                                                                                                                                                                                        }

                                                                                                                                                                                                            void IncreaseArms()
                                                                                                                                                                                                                {
                                                                                                                                                                                                                            armLength += 0.05f;

                                                                                                                                                                                                                                    if (armLength > 1.5f)
                                                                                                                                                                                                                                                armLength = 1.5f;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                    void DecreaseArms()
                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                    armLength -= 0.05f;

                                                                                                                                                                                                                                            if (armLength < 1f)
                                                                                                                                                                                                                                                        armLength = 1f;
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                            void HandleFly()
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                            Camera cam =
                                                                                                                                                                                                                                                        Camera.main;

                                                                                                                                                                                                                                                                if (cam == null)
                                                                                                                                                                                                                                                                            return;

                                                                                                                                                                                                                                                                                    float forward =
                                                                                                                                                                                                                                                                                                Input.GetAxis("Vertical");

                                                                                                                                                                                                                                                                                                        float sideways =
                                                                                                                                                                                                                                                                                                                    Input.GetAxis("Horizontal");

                                                                                                                                                                                                                                                                                                                            Vector3 direction =
                                                                                                                                                                                                                                                                                                                                        cam.transform.forward *
                                                                                                                                                                                                                                                                                                                                                    forward;

                                                                                                                                                                                                                                                                                                                                                            direction +=
                                                                                                                                                                                                                                                                                                                                                                        cam.transform.right *
                                                                                                                                                                                                                                                                                                                                                                                    sideways;

                                                                                                                                                                                                                                                                                                                                                                                            transform.position +=
                                                                                                                                                                                                                                                                                                                                                                                                        direction *
                                                                                                                                                                                                                                                                                                                                                                                                                    5f *
                                                                                                                                                                                                                                                                                                                                                                                                                                Time.deltaTime;
                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                    void SafeDisconnect()
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                    // Safely return to the game's
                                                                                                                                                                                                                                                            // normal/menu scene rather than
                                                                                                                                                                                                                                                                    // interfering with networking.

                                                                                                                                                                                                                                                                            try
                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                    SceneManager.LoadScene(
                                                                                                                                                                                                                                                                                                                        "Main Menu"
                                                                                                                                                                                                                                                                                                    );
                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                            catch
                                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                                    Debug.Log(
                                                                                                                                                                                                                                                                                                                                        "Disconnect requested."
                                                                                                                                                                                                                                                                                                                    );
                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                            void UpdateButtons()
                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                            if (buttons.Count < 4)
                                                                                                                                                                                                                                                                        return;

                                                                                                                                                                                                                                                                                SetColor(
                                                                                                                                                                                                                                                                                                buttons[0],
                                                                                                                                                                                                                                                                                                            flyEnabled
                                                                                                                                                                                                                                                                                );

                                                                                                                                                                                                                                                                                        SetColor(
                                                                                                                                                                                                                                                                                                        buttons[1],
                                                                                                                                                                                                                                                                                                                    speedEnabled
                                                                                                                                                                                                                                                                                        );

                                                                                                                                                                                                                                                                                                SetColor(
                                                                                                                                                                                                                                                                                                                buttons[2],
                                                                                                                                                                                                                                                                                                                            longArmsEnabled
                                                                                                                                                                                                                                                                                                );

                                                                                                                                                                                                                                                                                                        SetColor(
                                                                                                                                                                                                                                                                                                                        buttons[3],
                                                                                                                                                                                                                                                                                                                                    teleportEnabled
                                                                                                                                                                                                                                                                                                        );
                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                    void SetColor(
                                                                                                                                                                                                                                                                GameObject obj,
                                                                                                                                                                                                                                                                        bool enabled
                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                                    Image image =
                                                                                                                                                                                                                                                                                obj.GetComponent<Image>();

                                                                                                                                                                                                                                                                                        if (image != null)
                                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                                                image.color =
                                                                                                                                                                                                                                                                                                                                enabled
                                                                                                                                                                                                                                                                                                                                                ? buttonOn
                                                                                                                                                                                                                                                                                                                                                                : buttonOff;
                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                        }
}
